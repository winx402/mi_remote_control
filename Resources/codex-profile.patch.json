{
  "profiles": {
    "global": {
      "tv": { "tap": { "type": "open_app", "value": "com.openai.codex" } }
    },
    "com.openai.codex": {
      "tv": {
        "tap": { "type": "layer_toggle", "value": 2 },
        "double": { "type": "key_stroke", "key": "m", "mods": ["left_ctrl", "left_shift"] },
        "layers": { "2": { "type": "layer_toggle", "value": 2 } }
      },
      "left": {
        "layers": { "2": { "type": "key_stroke", "key": "left_arrow", "mods": ["left_cmd", "left_option"] } }
      },
      "right": {
        "layers": { "2": { "type": "key_stroke", "key": "right_arrow", "mods": ["left_cmd", "left_option"] } }
      },
      "up": { "layers": { "2": { "type": "key_stroke", "key": "page_up" } } },
      "down": { "layers": { "2": { "type": "key_stroke", "key": "page_down" } } },
      "ok": {
        "tap": { "type": "key_stroke", "key": "return" },
        "layers": { "2": { "type": "key_stroke", "key": "return" } }
      },
      "back": { "layers": { "2": { "type": "key_stroke", "key": "escape" } } },
      "menu": {
        "tap": { "type": "key_stroke", "key": "p", "mods": ["left_cmd", "left_shift"] },
        "layers": { "2": { "type": "key_stroke", "key": "p", "mods": ["left_cmd", "left_shift"] } }
      },
      "home": { "hold": { "type": "key_stroke", "key": "n", "mods": ["left_cmd"] } },
      "volUp": { "layers": { "2": { "type": "system", "value": "volume_up" } } },
      "volDown": { "layers": { "2": { "type": "system", "value": "volume_down" } } }
    }
  }
}
