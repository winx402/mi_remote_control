{
  "settings": {
    "holdMs": 600,
    "doubleMs": 250
  },
  "globalShortcuts": {
    "power": {
      "tap": {
        "type": "overlay",
        "value": "computer_power"
      },
      "hold": {
        "type": "none"
      }
    },
    "home": {
      "double": {
        "type": "overlay",
        "value": "window_picker"
      }
    },
    "menu": {
      "double": {
        "type": "overlay",
        "value": "system_menu"
      },
      "hold": {
        "type": "mouse_mode"
      }
    },
    "tv": {
      "tap": {
        "type": "open_app",
        "value": "com.openai.codex"
      },
      "double": {
        "type": "system",
        "value": "app_mru_back"
      }
    },
    "back": {
      "hold": {
        "type": "system",
        "value": "remote_reset"
      },
      "holdMs": 1200
    },
    "volUp": {
      "tap": {
        "type": "system",
        "value": "volume_up"
      }
    },
    "volDown": {
      "tap": {
        "type": "system",
        "value": "volume_down"
      }
    },
    "left": {
      "double": {
        "type": "system",
        "value": "space_left"
      }
    },
    "right": {
      "double": {
        "type": "system",
        "value": "space_right"
      }
    }
  },
  "profiles": {
    "global": {
      "power": {
        "tap": {
          "type": "none"
        },
        "hold": {
          "type": "none"
        }
      },
      "home": {
        "tap": {
          "type": "none"
        },
        "hold": {
          "type": "none"
        }
      },
      "menu": {
        "tap": {
          "type": "none"
        },
        "hold": {
          "type": "none"
        }
      },
      "tv": {
        "tap": {
          "type": "none"
        },
        "hold": {
          "type": "none"
        }
      },
      "voice": {
        "tap": {
          "type": "voice"
        },
        "hold": {
          "type": "voice"
        }
      }
    },
    "com.openai.codex": {
      "up": {
        "tap": {
          "type": "key_stroke",
          "key": "up_arrow",
          "mods": []
        }
      },
      "down": {
        "tap": {
          "type": "key_stroke",
          "key": "down_arrow",
          "mods": []
        }
      },
      "left": {
        "overrideBase": true,
        "tap": {
          "type": "system",
          "value": "codex_previous_chat"
        }
      },
      "right": {
        "overrideBase": true,
        "tap": {
          "type": "system",
          "value": "codex_next_chat"
        }
      },
      "ok": {
        "tap": {
          "type": "key_stroke",
          "key": "return",
          "mods": []
        },
        "hold": {
          "type": "none"
        }
      },
      "back": {
        "overrideBase": true,
        "tap": {
          "type": "key_stroke",
          "key": "escape",
          "mods": []
        }
      },
      "home": {
        "tap": {
          "type": "overlay",
          "value": "codex_sessions"
        },
        "hold": {
          "type": "key_stroke",
          "key": "n",
          "mods": [
            "left_cmd"
          ]
        }
      },
      "menu": {
        "tap": {
          "type": "key_stroke",
          "key": "p",
          "mods": [
            "left_cmd",
            "left_shift"
          ]
        }
      },
      "tv": {
        "hold": {
          "type": "key_stroke",
          "key": "m",
          "mods": [
            "left_ctrl",
            "left_shift"
          ]
        }
      },
      "voice": {
        "tap": {
          "type": "focus_input"
        },
        "hold": {
          "type": "voice"
        }
      }
    }
  },
  "voiceProfiles": {
    "global": {
      "keyName": "fn",
      "mode": "hold",
      "imeBundlePrefix": "com.tencent.inputmethod.wetype"
    }
  }
}
